# Port the API listens on
PORT=5000

# Your deployed front-end origin, for CORS (comma-separate multiple origins)
CLIENT_URL=http://localhost:5173

# SMTP credentials used to relay the contact form (no database — email only)
# Works with Gmail (use an App Password), Zoho, Outlook, or any SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# Where contact-form submissions should be delivered
CONTACT_TO_EMAIL=you@example.com
